# Copy to .env and fill in. .env is git-ignored: never commit it.

# --- Dedicated server account (https://players.trackmania.com/server/dedicated) ---
TM_MASTERSERVER_LOGIN=
TM_MASTERSERVER_PASSWORD=

# --- XML-RPC passwords of the dedicated server (choose long random values) ---
TM_AUTHORIZATION_SUPERADMIN_PASSWORD=
TM_AUTHORIZATION_ADMIN_PASSWORD=
TM_AUTHORIZATION_USER_PASSWORD=

# --- Optional server settings ---
TM_SERVER_NAME="PitWall test server"
TM_SERVER_PASSWORD=
TM_SERVER_MAX_PLAYERS=16
# Public IP:port announced to players when the automatic one is wrong (Docker NAT).
TM_SYSTEM_FORCE_IP_ADDRESS=
# XML-RPC: private address to bind (127.0.0.1, or a Tailscale IP to reach it from another machine) and port.
TM_XMLRPC_BIND=127.0.0.1
TM_XMLRPC_PORT=5000

# --- PitWall (read from this file when the controller runs on the host) ---
PITWALL_SERVER__PASSWORD=${TM_AUTHORIZATION_SUPERADMIN_PASSWORD}
# Web dashboard admin token (long random string).
PITWALL_API__ADMIN_TOKEN=
# Discord channel webhook for cup announcements (optional).
PITWALL_DISCORD__WEBHOOK_URL=
# Nadeo API (club/campaign maps): the dedicated server account works.
PITWALL_NADEO__LOGIN=${TM_MASTERSERVER_LOGIN}
PITWALL_NADEO__PASSWORD=${TM_MASTERSERVER_PASSWORD}
