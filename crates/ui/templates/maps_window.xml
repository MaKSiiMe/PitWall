<manialink id="{{ id }}" version="3" name="PitWall:Maps">
<frame pos="-80 60" z-index="40">
	<quad pos="0 0" z-index="0" size="160 118" bgcolor="{{ theme.background }}" opacity="{{ bg_opacity }}" scriptevents="1"/>
	<quad pos="0 0" z-index="1" size="160 0.6" bgcolor="{{ theme.accent }}"/>
	<label pos="3 -4" z-index="2" size="140 5" valign="center2" textfont="GameFontExtraBold" textsize="1.4" textcolor="{{ theme.text }}" text="{{ title }}"/>
	<label pos="155 -4" z-index="2" size="6 5" halign="center" valign="center2" textfont="GameFontExtraBold" textsize="1.4" textcolor="{{ theme.text }}" text="X" action="pw:maps:close" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.bad }}"/>

{%- for row in rows %}
	<frame pos="2 {{ row.y }}" z-index="2">
{%- if row.current %}
		<quad pos="0 0" z-index="0" size="100 5.2" bgcolor="{{ theme.accent }}" opacity="0.25"/>
		<quad pos="0 0" z-index="1" size="0.6 5.2" bgcolor="{{ theme.accent }}"/>
{%- else if row.odd %}
		<quad pos="0 0" z-index="0" size="100 5.2" bgcolor="fff" opacity="0.04"/>
{%- endif %}
		<label pos="7 -2.6" z-index="2" size="6 5" halign="right" valign="center2" textfont="GameFontSemiBold" textsize="1" textcolor="{% if row.current %}{{ theme.accent }}{% else %}{{ theme.muted }}{% endif %}" text="{{ row.number }}"/>
		<label pos="9 -2.6" z-index="2" size="50 5" valign="center2" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ row.name }}"/>
		<label pos="60 -2.6" z-index="2" size="19 5" valign="center2" textfont="GameFontRegular" textsize="0.8" textcolor="{{ theme.muted }}" text="{{ row.author }}"/>
{%- for b in row.buttons %}
		<label pos="{{ b.x }} -2.6" z-index="2" size="3.8 4.6" halign="center" valign="center2" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ b.label }}" action="{{ b.action }}" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ b.color }}"/>
{%- endfor %}
	</frame>
{%- endfor %}
{%- if rows.is_empty() %}
	<label pos="4 -12" z-index="2" size="96 5" valign="center2" textfont="GameFontRegular" textsize="1" textcolor="{{ theme.muted }}" text="{{ empty_label }}"/>
{%- endif %}

{%- if pages > 1 %}
{%- if let Some(action) = prev_action %}
	<label pos="36 -100" z-index="2" size="6 5" halign="center" valign="center2" textfont="GameFontExtraBold" textsize="1.2" textcolor="{{ theme.text }}" text="«" action="{{ action }}" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
{%- endif %}
	<label pos="52 -100" z-index="2" size="24 5" halign="center" valign="center2" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.muted }}" text="{{ page_label }}"/>
{%- if let Some(action) = next_action %}
	<label pos="68 -100" z-index="2" size="6 5" halign="center" valign="center2" textfont="GameFontExtraBold" textsize="1.2" textcolor="{{ theme.text }}" text="»" action="{{ action }}" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
{%- endif %}
{%- endif %}
	<label pos="2 -110" z-index="2" size="40 5" valign="center2" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ clear_label }}" scriptevents="1" id="pw-maps-clear" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.bad }}"/>
	<label pos="44 -110" z-index="2" size="56 5" valign="center2" textfont="GameFontRegular" textsize="0.8" textcolor="{{ theme.muted }}" text="{{ legend }}"/>

	<quad pos="105 -8" z-index="1" size="0.3 106" bgcolor="{{ theme.muted }}" opacity="0.3"/>
	<label pos="108 -11" z-index="2" size="50 5" valign="center2" textfont="GameFontExtraBold" textsize="1" textcolor="{{ theme.accent }}" text="{{ add_title }}"/>
	<quad pos="107 -14.5" z-index="1" size="51 6" bgcolor="fff" opacity="0.08"/>
	<quad pos="107 -20.3" z-index="1" size="51 0.3" bgcolor="{{ theme.accent }}"/>
	<entry pos="108 -15" z-index="2" size="50 5" valign="top" textsize="1" textcolor="{{ theme.text }}" default="" id="pw-tmx-id" scriptevents="1"/>
	<label pos="108 -23" z-index="2" size="24 5" valign="center2" halign="left" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ add_label }}" scriptevents="1" id="pw-tmx-add" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
	<label pos="134 -23" z-index="2" size="24 5" valign="center2" halign="left" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ add_next_label }}" scriptevents="1" id="pw-tmx-next" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>

	<label pos="108 -33" z-index="2" size="50 5" valign="center2" textfont="GameFontExtraBold" textsize="1" textcolor="{{ theme.accent }}" text="{{ club_title }}"/>
	<label pos="108 -37.5" z-index="2" size="24 3" valign="center2" textfont="GameFontRegular" textsize="0.7" textcolor="{{ theme.muted }}" text="{{ club_id_label }}"/>
	<label pos="134 -37.5" z-index="2" size="24 3" valign="center2" textfont="GameFontRegular" textsize="0.7" textcolor="{{ theme.muted }}" text="{{ club_item_label }}"/>
	<quad pos="107 -39.5" z-index="1" size="25 6" bgcolor="fff" opacity="0.08"/>
	<quad pos="107 -45.3" z-index="1" size="25 0.3" bgcolor="{{ theme.accent }}"/>
	<entry pos="108 -40" z-index="2" size="23 5" valign="top" textsize="1" textcolor="{{ theme.text }}" default="" id="pw-club-id" scriptevents="1"/>
	<quad pos="133 -39.5" z-index="1" size="25 6" bgcolor="fff" opacity="0.08"/>
	<quad pos="133 -45.3" z-index="1" size="25 0.3" bgcolor="{{ theme.accent }}"/>
	<entry pos="134 -40" z-index="2" size="23 5" valign="top" textsize="1" textcolor="{{ theme.text }}" default="" id="pw-club-item" scriptevents="1"/>
	<label pos="108 -48" z-index="2" size="24 5" valign="center2" halign="left" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ club_campaign_label }}" scriptevents="1" id="pw-club-campaign" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
	<label pos="134 -48" z-index="2" size="24 5" valign="center2" halign="left" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ club_room_label }}" scriptevents="1" id="pw-club-room" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>

	<label pos="108 -55" z-index="2" size="50 5" valign="center2" textfont="GameFontExtraBold" textsize="1" textcolor="{{ theme.accent }}" text="{{ search_title }}"/>
	<quad pos="107 -58.5" z-index="1" size="51 6" bgcolor="fff" opacity="0.08"/>
	<quad pos="107 -64.3" z-index="1" size="51 0.3" bgcolor="{{ theme.accent }}"/>
	<entry pos="108 -59" z-index="2" size="50 5" valign="top" textsize="1" textcolor="{{ theme.text }}" default="{{ query }}" id="pw-tmx-q" scriptevents="1"/>
	<label pos="108 -67" z-index="2" size="24 5" valign="center2" halign="left" textfont="GameFontSemiBold" textsize="1" textcolor="{{ theme.text }}" text="{{ search_label }}" scriptevents="1" id="pw-tmx-search" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
{%- for r in results %}
	<frame pos="108 {{ r.y }}" z-index="2">
		<label pos="0 -1.8" z-index="2" size="39 4" valign="center2" textfont="GameFontSemiBold" textsize="0.9" textcolor="{{ theme.text }}" text="{{ r.name }}"/>
		<label pos="0 -4.8" z-index="2" size="39 3" valign="center2" textfont="GameFontRegular" textsize="0.7" textcolor="{{ theme.muted }}" text="{{ r.author }}"/>
		<label pos="42.5 -3.2" z-index="2" size="4.4 5.4" halign="center" valign="center2" textfont="GameFontExtraBold" textsize="1.1" textcolor="{{ theme.text }}" text="+" action="{{ r.add }}" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
		<label pos="47.5 -3.2" z-index="2" size="4.4 5.4" halign="center" valign="center2" textfont="GameFontExtraBold" textsize="1.1" textcolor="{{ theme.text }}" text="»" action="{{ r.add_next }}" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
	</frame>
{%- endfor %}
{%- if no_result %}
	<label pos="108 -74" z-index="2" size="50 5" valign="center2" textfont="GameFontRegular" textsize="0.9" textcolor="{{ theme.muted }}" text="{{ no_result_label }}"/>
{%- endif %}
</frame>
<script><!--
// Entries are read here and sent as command lines; the server checks the role again.
main() {
	declare CMlEntry TmxId <=> (Page.GetFirstChild("pw-tmx-id") as CMlEntry);
	declare CMlEntry Query <=> (Page.GetFirstChild("pw-tmx-q") as CMlEntry);
	declare CMlEntry ClubId <=> (Page.GetFirstChild("pw-club-id") as CMlEntry);
	declare CMlEntry ClubItem <=> (Page.GetFirstChild("pw-club-item") as CMlEntry);
	declare CMlLabel Clear <=> (Page.GetFirstChild("pw-maps-clear") as CMlLabel);
	declare Integer ClearArmedUntil = 0;
	while (True) {
		yield;
		if (ClearArmedUntil > 0 && Now > ClearArmedUntil) {
			ClearArmedUntil = 0;
			Clear.Value = "{{ clear_label_ms|safe }}";
		}
		foreach (Event in PendingEvents) {
			declare Text Action = "";
			if (Event.Type == CMlScriptEvent::Type::EntrySubmit) {
				if (Event.ControlId == "pw-tmx-id" && TmxId.Value != "") {
					Action = "pw:cmd:map tmx " ^ TmxId.Value;
				}
				if (Event.ControlId == "pw-tmx-q" && Query.Value != "") {
					Action = "pw:cmd:map search " ^ Query.Value;
				}
			} else if (Event.Type == CMlScriptEvent::Type::MouseClick) {
				if (Event.ControlId == "pw-tmx-add" && TmxId.Value != "") {
					Action = "pw:cmd:map tmx " ^ TmxId.Value;
				}
				if (Event.ControlId == "pw-tmx-next" && TmxId.Value != "") {
					Action = "pw:cmd:map tmx " ^ TmxId.Value ^ " next";
				}
				if (Event.ControlId == "pw-tmx-search" && Query.Value != "") {
					Action = "pw:cmd:map search " ^ Query.Value;
				}
				if (ClubId.Value != "" && ClubItem.Value != "") {
					if (Event.ControlId == "pw-club-campaign") {
						Action = "pw:cmd:map club " ^ ClubId.Value ^ " " ^ ClubItem.Value;
					}
					if (Event.ControlId == "pw-club-room") {
						Action = "pw:cmd:map room " ^ ClubId.Value ^ " " ^ ClubItem.Value;
					}
				}
				if (Event.ControlId == "pw-maps-clear") {
					// Two clicks within 3 s.
					if (ClearArmedUntil > 0) {
						ClearArmedUntil = 0;
						Action = "pw:cmd:map clear";
					} else {
						ClearArmedUntil = Now + 3000;
						Clear.Value = "{{ clear_confirm_ms|safe }}";
					}
				}
			}
			if (Action != "") {
				TriggerPageAction(Action);
			}
		}
	}
}
--></script>
</manialink>
