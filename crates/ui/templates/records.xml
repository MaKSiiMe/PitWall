<manialink id="{{ id }}" version="3" name="PitWall:Records">
<frame pos="{{ x }} {{ y }}" z-index="10" id="records">
	<quad pos="0 0" z-index="0" size="{{ width }} 5" bgcolor="{{ theme.background }}" opacity="{{ bg_opacity }}"/>
	<quad pos="0 0" z-index="1" size="0.6 5" bgcolor="{{ theme.accent }}"/>
	<label pos="2.5 -2.5" z-index="2" size="{{ title_width }} 5" valign="center2" textfont="GameFontExtraBold" textsize="1.3" textcolor="{{ theme.text }}" text="{{ title }}"/>
	<frame pos="0 -5.5" z-index="1">
{%- for i in 0..max_rows %}
		<frame pos="0 -{{ row_offsets[i] }}" z-index="1" id="rec-{{ i }}" hidden="1">
			<quad pos="0 0" z-index="0" size="{{ width }} {{ row_inner }}" bgcolor="{{ theme.background }}" opacity="{{ bg_opacity }}"/>
			<quad pos="0 0" z-index="1" size="0.6 {{ row_inner }}" bgcolor="{{ theme.accent }}" id="rec-{{ i }}-hl" hidden="1"/>
			<label pos="3.2 -{{ row_half }}" z-index="2" size="5 {{ row_inner }}" halign="center" valign="center2" textfont="GameFontExtraBold" textsize="1.1" textcolor="{{ theme.accent }}" text="{{ i + 1 }}"/>
			<label pos="6.5 -{{ row_half }}" z-index="2" size="{{ name_width }} {{ row_inner }}" valign="center2" textfont="GameFontSemiBold" textsize="1.1" textcolor="{{ theme.text }}" id="rec-{{ i }}-name"/>
			<label pos="{{ value_x }} -{{ row_half }}" z-index="2" size="13 {{ row_inner }}" halign="right" valign="center2" textfont="OswaldMono" textsize="1.1" textcolor="{{ theme.text }}" id="rec-{{ i }}-time"/>
		</frame>
{%- endfor %}
	</frame>
</frame>
<script><!--
#Include "TextLib" as TL

#Const C_MaxRows {{ max_rows }}

#Struct K_Row {
	Text login;
	Text name;
	Integer time;
}

#Struct K_Data {
	K_Row[] rows;
}

main() {
	declare Text {{ prefix }}_Json for LocalUser;
	declare Integer {{ prefix }}_Serial for LocalUser;
	declare Integer LastSerial = -1;
	while (True) {
		yield;
		if (LastSerial == {{ prefix }}_Serial) continue;
		LastSerial = {{ prefix }}_Serial;
		declare K_Data Data;
		if (!Data.fromjson({{ prefix }}_Json)) continue;
		for (I, 0, C_MaxRows - 1) {
			declare CMlFrame Frame <=> (Page.GetFirstChild("rec-"^I) as CMlFrame);
			if (I >= Data.rows.count) {
				Frame.Visible = False;
				continue;
			}
			declare K_Row Row = Data.rows[I];
			declare CMlLabel LabelName <=> (Page.GetFirstChild("rec-"^I^"-name") as CMlLabel);
			declare CMlLabel LabelTime <=> (Page.GetFirstChild("rec-"^I^"-time") as CMlLabel);
			declare CMlQuad Highlight <=> (Page.GetFirstChild("rec-"^I^"-hl") as CMlQuad);
			LabelName.Value = Row.name;
			LabelTime.Value = TL::TimeToText(Row.time, True, True);
			Highlight.Visible = Row.login == LocalUser.Login;
			Frame.Visible = True;
		}
	}
}
--></script>
</manialink>
