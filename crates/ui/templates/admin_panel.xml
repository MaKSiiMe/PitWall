<manialink id="{{ id }}" version="3" name="PitWall:AdminPanel">
<frame pos="{{ x }} {{ y }}" z-index="10" id="pw-root">
	<quad pos="0 0" z-index="0" size="{{ width }} 5" bgcolor="{{ theme.background }}" opacity="{{ bg_opacity }}" scriptevents="1" id="pw-admin-toggle"/>
	<quad pos="0 0" z-index="1" size="0.6 5" bgcolor="{{ theme.accent }}"/>
	<label pos="2.5 -2.5" z-index="2" size="{{ title_width }} 5" valign="center2" textfont="GameFontExtraBold" textsize="1.1" textcolor="{{ theme.text }}" text="{{ title }}"/>
	<label pos="{{ chevron_x }} -2.5" z-index="2" size="4 5" halign="center" valign="center2" textfont="GameFontExtraBold" textsize="1.1" textcolor="{{ theme.accent }}" text="▾" id="pw-admin-chevron"/>
	<frame pos="0 0" z-index="1" id="pw-admin-body">
		<quad pos="0 -5" z-index="0" size="{{ width }} {{ body_height }}" bgcolor="{{ theme.background }}" opacity="{{ bg_opacity }}"/>
{%- for button in buttons %}
		<label pos="{{ button.x }} -{{ button.y }}" z-index="2" size="{{ button_width }} 4.4" halign="center" valign="center2" textfont="GameFontSemiBold" textsize="0.9" textcolor="{{ theme.text }}" text="{{ button.label }}" action="{{ button.action }}" focusareacolor1="{{ bg_rgba }}" focusareacolor2="{{ theme.accent }}"/>
{%- endfor %}
	</frame>
</frame>
<script><!--
Void Apply(Boolean _Collapsed) {
	declare CMlFrame Body <=> (Page.GetFirstChild("pw-admin-body") as CMlFrame);
	declare CMlLabel Chevron <=> (Page.GetFirstChild("pw-admin-chevron") as CMlLabel);
	Body.Visible = !_Collapsed;
	if (_Collapsed) {
		Chevron.Value = "▸";
	} else {
		Chevron.Value = "▾";
	}
}

main() {
	declare Boolean PitWall_AdminCollapsed for LocalUser;
	declare Boolean {{ hidden_var }} for LocalUser;
	declare Boolean PitWall_HideAll for LocalUser;
	declare CMlFrame Root <=> (Page.GetFirstChild("pw-root") as CMlFrame);
	Apply(PitWall_AdminCollapsed);
	while (True) {
		yield;
		Root.Visible = !(PitWall_HideAll || {{ hidden_var }});
		foreach (Event in PendingEvents) {
			if (Event.Type == CMlScriptEvent::Type::MouseClick && Event.ControlId == "pw-admin-toggle") {
				PitWall_AdminCollapsed = !PitWall_AdminCollapsed;
				Apply(PitWall_AdminCollapsed);
			}
		}
	}
}
--></script>
</manialink>
