# Paste in Portainer → stack → Environment variables → "Advanced mode", then fill in.
TM_MASTERSERVER_LOGIN=
TM_MASTERSERVER_PASSWORD=
TM_AUTHORIZATION_SUPERADMIN_PASSWORD=
TM_AUTHORIZATION_ADMIN_PASSWORD=
TM_AUTHORIZATION_USER_PASSWORD=
TM_SERVER_NAME=PitWall
TM_SERVER_MAX_PLAYERS=16
TM_SYSTEM_FORCE_IP_ADDRESS=
# Private address for XML-RPC (development controller) and the web dashboard.
TM_XMLRPC_BIND=100.124.153.20
PITWALL_WEB_BIND=100.124.153.20
# Trackmania logins (trackmania.io short id), quoted, comma-separated.
PITWALL_SUPERADMINS=["X6N6WxRIR_Sj6Xr10yuDJA"]
PITWALL_ADMINS=[]
# Trackmania club ids (trackmania.io/#/clubs/<id>) whose members are admins, e.g. [12345].
PITWALL_ADMIN_CLUBS=[]
# true: every player may add maps.
PITWALL_PLAYERS_CAN_ADD_MAPS=false
# true: records the GbxRemote traffic (docs/ENREGISTREMENT.fr.md).
PITWALL_RECORDING=false
PITWALL_API_ADMIN_TOKEN=
PITWALL_DISCORD_WEBHOOK_URL=
# World record names: OAuth application (Confidential) from api.trackmania.com/manager.
PITWALL_TM_API_CLIENT_ID=
PITWALL_TM_API_CLIENT_SECRET=
